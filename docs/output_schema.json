{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Black-Box Testing Output",
  "type": "object",
  "required": [
    "input_variables",
    "equivalence_partitions",
    "boundary_values",
    "test_cases",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "input_variables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "equivalence_partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "valid"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "valid": { "type": "boolean" },
          "representative_values": { "type": ["array", "null"] }
        }
      }
    },
    "boundary_values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable"],
        "additionalProperties": false,
        "properties": {
          "variable": { "type": "string" },
          "values": { "type": ["array", "null"] },
          "boundary_type": { "type": ["string", "null"] },
          "value": {},
          "expected_valid": { "type": ["boolean", "null"] }
        }
      }
    },
    "conditions": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "conditions", "actions", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "conditions": { "type": "object" },
          "actions": { "type": "object" },
          "description": { "type": "string" }
        }
      }
    },
    "factors": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "values": { "type": "array" }
        }
      }
    },
    "constraints": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "coverage_strategy": {
      "type": ["object", "null"],
      "required": ["method", "strength"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "strength": { "type": "integer" }
      }
    },
    "coverage_summary": {
      "type": ["object", "null"],
      "required": ["method", "strength", "constraints_applied"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string" },
        "strength": { "type": "integer" },
        "constraints_applied": { "type": "boolean" },
        "excluded_pairs": { "type": ["array", "null"] }
      }
    },
    "states": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "events": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "transitions": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "from_state", "event", "guard", "to_state", "action"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "from_state": { "type": "string" },
          "event": { "type": "string" },
          "guard": { "type": "string" },
          "to_state": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "coverage_summary": {
      "type": ["object", "null"],
      "required": [
        "total_equivalence_partitions",
        "covered_partitions",
        "total_boundary_conditions",
        "covered_boundary_conditions",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "total_equivalence_partitions": { "type": "integer" },
        "covered_partitions": { "type": "integer" },
        "total_boundary_conditions": { "type": "integer" },
        "covered_boundary_conditions": { "type": "integer" },
        "notes": { "type": "string" }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scenario", "inputs", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "covers_rule": { "type": ["string", "null"] },
          "scenario": { "type": "string" },
          "inputs": { "type": "object" },
          "combination": { "type": ["object", "null"] },
          "covers_pairs": {
            "type": ["array", "null"],
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "initial_state": { "type": ["string", "null"] },
          "steps": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["event", "expected_state"],
              "additionalProperties": false,
              "properties": {
                "event": { "type": "string" },
                "data": { "type": ["object", "null"] },
                "expected_state": { "type": "string" },
                "expected_output": { "type": ["string", "null"] }
              }
            }
          },
          "expected": { "type": "string" }
        }
      }
    },
    "meta": {
      "type": ["object", "null"],
      "required": [
        "technique",
        "model",
        "temperature"
      ],
      "additionalProperties": false,
      "properties": {
        "technique": {
          "type": "string",
          "enum": [
            "ep_bva",
            "decision_table",
            "state_transition",
            "combinatorial"
          ]
        },
        "input_type": { "type": ["string", "null"], "enum": ["requirements", "codebase", null] },
        "prompt_version": { "type": ["string", "null"] },
        "model": { "type": "string" },
        "temperature": { "type": "number" }
      }
    },
    "notes": { "type": "string" }
  }
}
